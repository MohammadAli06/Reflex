# Copy to .env and fill in real values. Never commit .env.
# All values below are placeholders.

GOOGLE_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_THINKING_LEVEL=low
ADMIN_KEY=
MOCK_API_URL=http://localhost:8000
CONTROL_API_URL=http://localhost:8001
MOCK_TENANT_TOKEN=
HEADER_X_TENANT_TOKEN=
MAX_SCHEMA_ATTEMPTS=3
MAX_INFRA_RETRIES=2
LLM_FALLBACK_ENABLED=false
AUDIT_LOG_PATH=audit/audit.jsonl
RESULTS_DIR=results
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=
DATA_DIR=data
ADMIN_USER=operator
ADMIN_PASS=reflex2026

# Schema provenance. The mock signs /openapi.json with Ed25519.
# Leave SCHEMA_PUBLIC_KEY empty to discover the mock's boot key (dev only);
# pin the hex public key in any deployment that matters.
SCHEMA_SIGNING_ENABLED=true
SCHEMA_PUBLIC_KEY=

# Pre-emptive drift watch (not implemented yet; read and reported by /api/status).
SPEC_WATCH_INTERVAL_S=5

# LLM repair fallback. Rules always run first; the LLM is consulted at most
# once per failure event, only when the rule engine has no confident candidate
# (never on safety refusals). Requires GOOGLE_API_KEY; the Gemini adapter is
# the configured provider.
LLM_REPAIR_ENABLED=false
